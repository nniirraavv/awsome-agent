# AWS — your chatbot's account
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=YOUR_CHATBOT_ACCOUNT_ID
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# DynamoDB
DYNAMODB_TABLE_TENANTS=chatbot-tenants
DYNAMODB_TABLE_CHAT_HISTORY=chatbot-chat-history
DYNAMODB_TABLE_SESSIONS=chatbot-sessions

# S3 — CloudFormation template hosting
CFN_TEMPLATE_BUCKET=chatbot-cfn-templates
CFN_TEMPLATE_S3_URL=https://chatbot-cfn-templates.s3.amazonaws.com/chatbot-role-template.yaml

# Auth
COGNITO_USER_POOL_ID=us-east-1_xxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1

# Server
PORT=3001
NODE_ENV=development

# MCP
MCP_SPAWN_TIMEOUT_MS=15000
MCP_MAX_SERVERS_PER_SESSION=15
MCP_CREDENTIAL_REFRESH_THRESHOLD_MINUTES=15

# Local dev only — bypasses Cognito auth
LOCAL_DEV_BYPASS_AUTH=true
LOCAL_DEV_TENANT_ID=local-tenant-001
LOCAL_DEV_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT:role/YOUR_LOCAL_TEST_ROLE
